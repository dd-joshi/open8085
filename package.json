{
  "name": "open8085-lab",
  "version": "0.1.0",
  "description": "A browser-based Intel 8085 assembler, simulator, debugger, and virtual laboratory trainer.",
  "private": true,
  "author": "Mr. D. D. Joshi",
  "license": "MIT",
  "keywords": [
    "8085",
    "assembly-language",
    "assembler",
    "cpu-emulator",
    "education",
    "microprocessor",
    "simulator"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run typecheck && npm run test:cpu && npm run test:isa && npm run test:io && npm run test:app && npm run test:browser:built",
    "test:cpu": "npx tsx --test tests/core8085.test.ts tests/cpu8085-conformance.test.ts tests/cpu8085-flags-conformance.test.ts tests/engine-golden.test.ts",
    "test:isa": "npx tsx --test tests/assembler8085-conformance.test.ts tests/disassembler8085-conformance.test.ts tests/assembler-disassembler-contract.test.ts tests/instruction-metadata.test.ts",
    "test:io": "npx tsx --test tests/io-bus.test.ts tests/ppi8255.test.ts",
    "test:app": "npx tsx --test tests/byte-converter.test.ts tests/insight8085.test.ts && node --test tests/rendered-html.test.mjs tests/deployment-hygiene.test.mjs",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "node tests/run-browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
